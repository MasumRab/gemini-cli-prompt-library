#!/bin/bash
# List all sessions
set -euo pipefail

BASE_URL="https://jules.googleapis.com/v1alpha"

if [ -z "${JULES_API_KEY:-}" ]; then
    echo "Error: JULES_API_KEY is not set." >&2
    exit 1
fi

if command -v uv &>/dev/null && [ -f "tools/sessions/jules_list_sessions.py" ]; then
    exec uv run python -m tools.sessions.jules_list_sessions
elif command -v python3 &>/dev/null && [ -f "tools/sessions/jules_list_sessions.py" ]; then
    exec PYTHONPATH=. python3 -m tools.sessions.jules_list_sessions
else
    echo "Warning: Falling back to curl." >&2
    curl -sf -H "X-Goog-Api-Key: $JULES_API_KEY" "$BASE_URL/sessions"
fi
