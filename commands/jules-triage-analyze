#!/bin/bash
# Analyze unanswered questions for a session
set -euo pipefail

if [ -z "${JULES_API_KEY:-}" ]; then
    echo "Error: JULES_API_KEY is not set." >&2
    exit 1
fi

SESSION_ID=${1:-}
if [ -z "$SESSION_ID" ]; then
    echo "Usage: $0 <session_id>" >&2
    exit 1
fi

if command -v uv &>/dev/null && [ -f "tools/sessions/analyze_unanswered.py" ]; then
    exec uv run python -m tools.sessions.analyze_unanswered "$SESSION_ID"
elif command -v python3 &>/dev/null && [ -f "tools/sessions/analyze_unanswered.py" ]; then
    exec PYTHONPATH=. python3 -m tools.sessions.analyze_unanswered "$SESSION_ID"
else
    echo "Error: analyze command requires the Python tool suite (no curl fallback)." >&2
    exit 1
fi
