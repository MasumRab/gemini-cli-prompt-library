# Jules API debug captures
activities_*.json

# Forensics bulk data (large generated/exported captures; keep local only)

# Canonical Jules workspace policy
# Session projections are local-only: raw pulls, patches, REST/SDK exports,
# summaries, and generated session state never belong in the Jules repo.
# Put durable findings in workspaces/<repo>/analysis/ instead.
/workspaces/*/sessions/
# Per-session state contains disposable registered worktrees. Keep the state
# directory itself visible; only its contents are ignored.
/workspaces/*/state/*/**
# Workspace-local caches, generated output, and temporary exports.
.jules/cache/**
/workspaces/*/.cache/**
/workspaces/*/cache/**
/workspaces/*/generated/**
/workspaces/*/tmp/**
