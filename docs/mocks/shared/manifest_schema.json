{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plugin Manifest",
  "type": "object",
  "properties": {
    "plugin": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "version", "type"]
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exports": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supports": {
      "type": "object",
      "properties": {
        "dspy": { "type": "boolean" },
        "moa": { "type": "boolean" },
        "benchmark": { "type": "boolean" },
        "critic": { "type": "boolean" }
      },
      "required": ["dspy", "moa", "benchmark", "critic"]
    }
  },
  "required": ["plugin", "capabilities", "exports", "supports"]
}
